# Required. The bot won't start without these three.
# Token from @BotFather: send /newbot (see "Create your Telegram bot" in the README)
TROUBLESHOOTER_BOT_TOKEN=
# Your Telegram user ID, from @userinfobot. The owner approves access and admins.
TROUBLESHOOTER_OWNER_ID=
# MySQL database for the troubleshooter's own tables. Never falls back to JAWSDB_URL.
TROUBLESHOOTER_DB_URL=mysql://root:dev@localhost:3306/ts

# Optional
# Shown in menus and messages ("<name> Bot")
TROUBLESHOOTER_NAME=Test Troubleshooter
# Prefix for turbine IDs: WT turns A5 into WTA05
TROUBLESHOOTER_WTG_PREFIX=WT
# Group or channel ID for notifications (starts with -100). Empty sends them to the owner.
TROUBLESHOOTER_ALERTS_CHAT_ID=
TROUBLESHOOTER_TIMEZONE=Europe/London
# Folder the menus' photos and PDFs are kept in. Use forward slashes, even on Windows.
TROUBLESHOOTER_FILES_DIR=media
# Sentry error reporting; off when empty
TROUBLESHOOTER_SENTRY_DSN=
# Test mode: notifications and broadcasts only reach the owner, and errors print a traceback.
# Remove it (or set 0) when the bot is used for real.
TROUBLESHOOTER_TEST_MODE=1

# Optional: 0 stops the owner being offered each release's What's new note
# TROUBLESHOOTER_ANNOUNCE_UPDATES=0

# Optional: make 💾 Save commit new photos and PDFs to the repo the bot is deployed from
# (for hosts that reset their disk, like Heroku). Run the bot from the top of that repo.
# The repo, as owner/name
# TROUBLESHOOTER_FILES_REPO=owner/repo
# Branch to commit to
# TROUBLESHOOTER_FILES_REPO_BRANCH=main
# Fine-grained token: this one repo only, Contents read and write
# TROUBLESHOOTER_FILES_REPO_TOKEN=

# Optional: 🌦 Weather
# Cefas WaveNet buoy ID for sea state
TROUBLESHOOTER_CEFAS_BUOY=
TROUBLESHOOTER_WINDQUEST_LOCATION=
TROUBLESHOOTER_WINDQUEST_API_KEY=
TROUBLESHOOTER_WINDQUEST_API_TOKEN=
